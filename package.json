{
  "name": "orbit",
  "version": "0.1.0",
  "private": true,
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "electron": "electron .",
    "desktop": "npm run build && electron .",
    "dist": "npm run build && CSC_IDENTITY_AUTO_DISCOVERY=false ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/ electron-builder",
    "ship": "npm run dist && rm -rf /Applications/Orbit.app && cp -R dist/mac-arm64/Orbit.app /Applications/ && open /Applications/Orbit.app"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dexie": "^4.4.2",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "fake-indexeddb": "^6.2.5",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "3.10.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.6"
  },
  "build": {
    "appId": "com.orbit.desktop",
    "productName": "Orbit",
    "asar": false,
    "files": [
      "electron/**/*",
      "out/**/*"
    ],
    "mac": {
      "target": "dir",
      "category": "public.app-category.productivity",
      "identity": null,
      "icon": "public/icon-512.png"
    }
  }
}
